{
  "name": "displaynetworks",
  "version": "1.0.0",
  "license": "MIT",
  "author": "webitup.biz",
  "description": "open source digital signage platform",
  "angular-cli": {},
  "scripts": {
    "ng": "ng",
    "build": "ng build && tsc -p server",
    "start": "NODE_ENV=prod node dist/server/app.js",
    "predev": "tsc -p server",
    "dev": "concurrently \"mongod\" \"ng serve --proxy-config proxy.conf.json --open\" \"tsc -w -p server\" \"nodemon dist/server/app.js\"",
    "prod": "ng build && tsc -p server && node dist/server/app.js",
    "test": "NODE_ENV=test jest --watch",
    "test:ci": "NODE_ENV=test jest --ci --coverage",
    "test:server": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.server.config.js --runInBand",
    "test:coverage:client": "NODE_ENV=test jest --coverage",
    "test:coverage:server": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --config jest.server.config.js --coverage",
    "test:coverage": "npm run test:coverage:client; npm run test:coverage:server",
    "lint": "NODE_ENV=test ng lint",
    "e2e:install": "npx playwright install --with-deps",
    "e2e": "npx playwright test"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@angular/common": "^21.2.18",
    "@angular/compiler": "^21.2.18",
    "@angular/core": "^21.2.18",
    "@angular/forms": "^21.2.18",
    "@angular/platform-browser": "^21.2.18",
    "@angular/platform-browser-dynamic": "^21.2.18",
    "@angular/router": "^21.2.18",
    "@angular/service-worker": "^21.2.18",
    "@auth0/angular-jwt": "^5.2.0",
    "bcryptjs": "^2.4.3",
    "bootstrap": "^5.3.8",
    "bson": "^7.3.2",
    "dotenv": "^16.4.5",
    "enhanced-resolve": "^4.1.1",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "font-awesome": "^4.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.21.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.18",
    "@angular/language-service": "^21.2.18",
    "@playwright/test": "^1.40.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.9.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "angular-eslint": "21.4.0",
    "concurrently": "^9.0.1",
    "eslint": "^10.11.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^16.2.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.1": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true,
    "unrs-resolver@1.12.2": true
  }
}
